{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Tauri Preview window with explicitly scoped native commands and file dialogs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
