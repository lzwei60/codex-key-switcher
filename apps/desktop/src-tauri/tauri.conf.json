{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Key Switcher Tauri Preview",
  "version": "1.0.5",
  "identifier": "com.codexkeyswitcher.tauri.preview",
  "build": {
    "beforeDevCommand": "pnpm --filter @codex-key-switcher/web dev",
    "devUrl": "http://localhost:3340",
    "beforeBuildCommand": "pnpm --filter @codex-key-switcher/web build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Key Switcher Tauri Preview",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage", "deb"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "Codex Key Switcher Tauri shell preview"
  }
}
